# Copie este archivo como backend/.env y complete los valores.
PORT=3000
NODE_ENV=production

# ── Datos ──
# PostgreSQL (recomendado en hostings sin disco permanente, como Render gratuito). Ej. Neon:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Sin DATABASE_URL se usa un archivo JSON (DATA_FILE, por defecto backend/data/requests.json).
# DATA_FILE=/var/data/requests.json
# Solicitudes sin cotizar se eliminan después de estos días (0 = nunca). Cotizadas y aprobadas se conservan.
RETENTION_DAYS=30

# ── Área Comercial (obligatorios en producción: el servidor no arranca con los valores demo) ──
# Genere la clave con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
COMMERCIAL_EMAIL=comercial@kasac.pe
COMMERCIAL_PASSWORD=
COMMERCIAL_NAME=Equipo Comercial KASAC

# ── Aviso por correo de cada nueva solicitud ──
NOTIFY_EMAIL=fabiocoyutupa@gmail.com
# Opción 1 (recomendada, funciona en Render gratuito): https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=KASAC Configurador <onboarding@resend.dev>
# Opción 2: SMTP (ej. Gmail con contraseña de aplicación)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=su-correo@gmail.com
# SMTP_PASS=contraseña-de-aplicación

# ── Otros ──
# Detrás de un proxy inverso (Render, Nginx...), para que el límite de intentos use la IP real:
# TRUST_PROXY=1
# Solo si la web está en otro hosting: formato del enlace que recibe el cliente.
# PUBLIC_REQUEST_URL=https://www.kasac.pe/configurador#/solicitud/{token}
# Versión pública sin Área Comercial:
# COMMERCIAL_ENABLED=false
