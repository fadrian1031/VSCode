{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "kasac-configurator": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/kasac-configurator",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": true
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "3MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "public": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "3MB"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/app.variant.ts",
                  "with": "src/app/app.variant.public.ts"
                }
              ]
            },
            "web": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "3MB"
                }
              ],
              "outputPath": "dist/kasac-configurator-web",
              "baseHref": "./",
              "fileReplacements": [
                {
                  "replace": "src/app/app.variant.ts",
                  "with": "src/app/app.variant.web.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": [
                    "config.js"
                  ]
                },
                {
                  "glob": "config.js",
                  "input": "src/web"
                }
              ]
            },
            "comercial": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "3MB"
                }
              ],
              "outputPath": "dist/kasac-comercial",
              "baseHref": "/comercial/",
              "fileReplacements": [
                {
                  "replace": "src/app/app.variant.ts",
                  "with": "src/app/app.variant.comercial.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "kasac-configurator:build:production"
            },
            "development": {
              "buildTarget": "kasac-configurator:build:development"
            },
            "public": {
              "buildTarget": "kasac-configurator:build:public"
            },
            "web": {
              "buildTarget": "kasac-configurator:build:web"
            },
            "comercial": {
              "buildTarget": "kasac-configurator:build:comercial"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
