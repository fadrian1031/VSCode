<?xml version="1.0" encoding="UTF-8"?>
<!-- KASAC - IIS (hosting Windows / Plesk). Requiere el módulo URL Rewrite. Usa este archivo O .htaccess, según el servidor. -->
<configuration>
  <system.webServer>
    <defaultDocument><files><clear /><add value="index.html" /></files></defaultDocument>
    <!-- Modelos 3D del configurador: IIS no sirve extensiones desconocidas -->
    <staticContent>
      <remove fileExtension=".glb" />
      <mimeMap fileExtension=".glb" mimeType="model/gltf-binary" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="Nosotros" stopProcessing="true"><match url="^Nosotros/?$" ignoreCase="false" /><action type="Redirect" url="/nosotros" redirectType="Permanent" /></rule>
        <rule name="Productos" stopProcessing="true"><match url="^Productos/?$" ignoreCase="false" /><action type="Redirect" url="/productos" redirectType="Permanent" /></rule>
        <rule name="Contacto" stopProcessing="true"><match url="^Contacto/?$" ignoreCase="false" /><action type="Redirect" url="/contacto" redirectType="Permanent" /></rule>
        <rule name="Motos" stopProcessing="true"><match url="^MotosCorporativas/?$" ignoreCase="false" /><action type="Redirect" url="/motos" redirectType="Permanent" /></rule>
        <rule name="Autos" stopProcessing="true"><match url="^AutosCorporativos/?$" ignoreCase="false" /><action type="Redirect" url="/autos" redirectType="Permanent" /></rule>
        <rule name="PickUp" stopProcessing="true"><match url="^PickUp/?$" ignoreCase="false" /><action type="Redirect" url="/pickup" redirectType="Permanent" /></rule>
        <rule name="SUV" stopProcessing="true"><match url="^SUV/?$" ignoreCase="false" /><action type="Redirect" url="/suv" redirectType="Permanent" /></rule>
        <rule name="Panel" stopProcessing="true"><match url="^Panel/?$" ignoreCase="false" /><action type="Redirect" url="/panel" redirectType="Permanent" /></rule>
        <rule name="Camiones" stopProcessing="true"><match url="^CamionesCorpMineros/?$" ignoreCase="false" /><action type="Redirect" url="/camiones" redirectType="Permanent" /></rule>
        <rule name="Separador" stopProcessing="true"><match url="^SeparadorCabina/?$" ignoreCase="false" /><action type="Redirect" url="/panel" redirectType="Permanent" /></rule>
        <rule name="Inicio" stopProcessing="true"><match url="^index(\.html)?$" /><action type="Redirect" url="/" redirectType="Permanent" /></rule>
        <rule name="Quitar .html" stopProcessing="true">
          <match url="^([^/.]+)\.html$" />
          <conditions><add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" /></conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="URLs limpias" stopProcessing="true">
          <match url="^([^.]+?)/?$" />
          <conditions><add input="{REQUEST_FILENAME}.html" matchType="IsFile" /></conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
